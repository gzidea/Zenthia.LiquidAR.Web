# Public application identifier assigned by Security; never use an invented ID.
VITE_SECURITY_APPLICATION_ID=
# Security URL, including /api. Supports an absolute URL or same-origin path.
# No tokens or secrets in VITE_* variables.
VITE_SECURITY_BASE_URL=/api
# Independent LiquidAR URL, including /api. Set the real development host/port.
VITE_LIQUIDAR_BASE_URL=http://192.168.1.4:5000/api
# Development proxy; matches Security's local launchSettings.json.
SECURITY_PROXY_TARGET=http://localhost:5103
# Optional trusted PEM certificate paths for Vite HTTPS (both required together).
# DEV_HTTPS_CERT=.certs/localhost.pem
# DEV_HTTPS_KEY=.certs/localhost-key.pem

# Docker/Portainer. Replace with the actual lowercase GHCR image reference.
LIQUIDAR_WEB_IMAGE=ghcr.io/propietario/repositorio:latest
SECURITY_API_ORIGIN=https://gateway.zenthia.ar
# Confirmed origin reachable from Docker; no credentials, trailing slash or /api.
LIQUIDAR_API_ORIGIN=https://liquidar-api.zenthia.ar
