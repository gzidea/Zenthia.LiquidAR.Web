# Desarrollo local con npm/Vite. VITE_* queda visible en el JavaScript del navegador.
# ID publico de LiquidAR registrado en Security; confirmar que corresponda al entorno.
VITE_SECURITY_APPLICATION_ID=2
# /api usa el proxy de vite.config.ts hacia https://gateway.zenthia.ar.
VITE_SECURITY_BASE_URL=/api
# URL que consume el navegador en desarrollo; incluye /api.
VITE_LIQUIDAR_BASE_URL=https://liquidar-api.zenthia.ar/api
# HTTPS local opcional: rutas a certificado y clave PEM; configurar ambos juntos.
# Docker no usa estos certificados. No subir claves ni secretos al repositorio.
# DEV_HTTPS_CERT=.certs/localhost.pem
# DEV_HTTPS_KEY=.certs/localhost-key.pem

# Docker Compose / variables del stack de Portainer.
# Imagen publicada por GitHub Actions.
LIQUIDAR_WEB_IMAGE=ghcr.io/gzidea/zenthia.liquidar.web:latest
# Destinos que usa Nginx desde el contenedor: sin /api ni barra final.
SECURITY_API_ORIGIN=https://gateway.zenthia.ar
LIQUIDAR_API_ORIGIN=https://liquidar-api.zenthia.ar

# GitHub Actions requiere aparte la variable de repositorio SECURITY_APPLICATION_ID.
# Este archivo no completa las variables de GitHub ni de Portainer automaticamente.
# Dockerfile fija las bases del navegador en /api y /liquidar-api al compilar.
